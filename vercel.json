{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/blog.js": { "includeFiles": "dist/index.html" } },
  "routes": [
    { "src": "^/blog-admin$", "dest": "/index.html", "headers": { "X-Robots-Tag": "noindex, nofollow" } },
    { "src": "^/$", "dest": "/api/blog" },
    { "handle": "filesystem" },
    { "src": "^/(activities|literature|news|bookroom|about)/?$", "dest": "/api/blog?view=$1" },
    { "src": "^/blog/([^/]+)/?$", "dest": "/api/blog?slug=$1" },
    { "src": "^/sitemap\\.xml$", "dest": "/api/sitemap" }
  ]
}
