{
  "name": "chms1clc-public-preview",
  "main": "worker.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "routes": [
    { "pattern": "chms1clc.org", "custom_domain": true },
    { "pattern": "www.chms1clc.org", "custom_domain": true }
  ],
  "vars": { "PUBLIC_SITE_INDEXABLE": "true" },
  "assets": {
    "directory": "../../test-results/cloudflare-preview-runtime",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/literature", "/literature/*", "/activities", "/activities/*", "/bookroom", "/bookroom/*", "/news", "/news/*", "/about", "/about/*", "/blog/*", "/api/*", "/public-media/*", "/member", "/member/*", "/blog-admin", "/blog-admin/*", "/sitemap.xml", "/robots.txt", "/manifest*.json", "/firebase-messaging-sw.js"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "r2_buckets": [{ "binding": "PUBLIC_SITE", "bucket_name": "chms1clc-photos" }],
  "triggers": { "crons": ["* * * * *"] }
}
